<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:background="?attr/selectableItemBackground"
  android:clickable="true"
  android:focusable="true"
  android:orientation="vertical"
  android:paddingHorizontal="@dimen/margin_half_plus"
  android:paddingVertical="@dimen/margin_half">

  <TextView
    android:id="@+id/live_transit_summary"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:textAppearance="?attr/textAppearanceSubtitle1"
    tools:text="34min · Direct" />

  <TextView
    android:id="@+id/live_transit_legs"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/margin_quarter"
    android:textAppearance="?attr/textAppearanceBody2"
    tools:text="Tram 11: Bahnhofplatz → Zoo" />

</LinearLayout>
